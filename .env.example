# Скопируйте файл в .env и заполните значениями. Не коммитьте .env.

# Токен доступа сообщества VK с правом получать и отправлять сообщения.
VK_TOKEN=

# Только для токена сообщества: числовой ID сообщества для Long Poll.
# Для пользовательского токена оставьте пустым.
VK_GROUP_ID=

# Точный текст согласия, утверждённый оператором персональных данных.
# Оставьте пустым до настройки.
PERSONAL_DATA_CONSENT_TEXT=
PERSONAL_DATA_CONSENT_VERSION=

# JSON сервисного аккаунта Google Sheets одной строкой. Выдайте email сервисного
# аккаунта доступ редактора к приватной таблице. Никогда не коммитьте реальные
# учётные данные.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SPREADSHEET_ID=
GOOGLE_SHEET_NAME=Clients

# Необязательный путь к CSV с товарами (по умолчанию ./catalog.csv).
CATALOG_PATH=./catalog.csv
